 \brief     Handles SDO read requests to TxPDO Parameter
*////////////////////////////////////////////////////////////////////////////////////////
UINT8 ReadObject0x8000(UINT16 index, UINT8 subindex, UINT32 dataSize,
                       UINT16 MBXMEM *pData, UINT8 bCompleteAccess) {
    if (bCompleteAccess) {
        return ABORTIDX_UNSUPPORTED_ACCESS;
    }
    switch (subindex) {
        case 0:          // Refers to 0x8000
            *pData = 2;  // Indicate the number of sub-indexes
            break;
        case 1:  // Refers to 0x8000 : Index 1
        	MLParameterSetting0x8000.MLSetting0 = 78; //getParameterValues(UPPER_LIMIT);
            memcpy(pData, &MLParameterSetting0x8000.MLSetting0, dataSize);
            break;
        case 2:  // Refers to 0x8000 : Index 2
        	MLParameterSetting0x8000.MLSetting1 = 99; //getParameterValues(LOWER_LIMIT);
            memcpy(pData, &MLParameterSetting0x8000.MLSetting1, dataSize);
            break;
        default:
            return ABORTIDX_SUBINDEX_NOT_EXISTING;
            break;
    }
    return 0;
}

