            memcpy(pData, &ADCCalibrationSetting0x8120.VoltageGradient, dataSize);
            break;
        case 4:  // Refers to 0x8120 : Index 4
			// TODO: Function to retrieve local value
            //AnalogHWSetting0x8400.AnalogHWSetting1 =
            //    getFeedbackValue(ADC_GRADIENT, ADC_ML_MERGED, 0);
			ADCCalibrationSetting0x8120.VoltageOffset = channel[current_channel].adc_voltage_offset; 		//voltage_offset_channel[0];
            memcpy(pData, &ADCCalibrationSetting0x8120.VoltageOffset, dataSize);
            break;
        case 5:  // Refers to 0x8120 : Index 5
			ADCCalibrationSetting0x8120.Channel = current_channel;  				// voltage_offset_channel[0];
			memcpy(pData, &ADCCalibrationSetting0x8120.Channel, dataSize);
			break;
        default:
            return ABORTIDX_SUBINDEX_NOT_EXISTING;
            break;
    }
    return 0;

}

/////////////////////////////////////////////////////////////////////////////////////////
/**
 \param     index               index of the requested object.
 \param     subindex            subindex of the requested object.
 \param     objSize             size of the requested object data, calculated
 with OBJ_GetObjectLength \param     pData               Pointer to the buffer
 where the data can be copied to \param     bCompleteAccess     Indicates if a
 complete read of all subindices of the object shall be done or not

 \return    ABORTIDX_XXX

 \brief     Handles SDO read requests to TxPDO Parameter
*////////////////////////////////////////////////////////////////////////////////////////
UINT8 WriteObject0x8120(UINT16 index, UINT8 subindex, UINT32 dataSize,
                        UINT16 MBXMEM *pData, UINT8 bCompleteAccess) {

    if (bCompleteAccess) {
        return ABORTIDX_UNSUPPORTED_ACCESS;
    }
    switch (subindex) {
        case 0:          // Refers to 0x8120
            *pData = 5;  // Indicate the number of sub-indexes
            break;
        case 1:  // Refers to 0x8120 : Index 1
            memcpy(&ADCCalibrationSetting0x8120.CurrentGradient, pData, dataSize);
            channel[current_channel].adc_current_gradient = ADCCalibrationSetting0x8120.CurrentGradient;
            //voltage_gradient_channel[channel] = ADCCalibrationSetting0x8120.Gradient;
            break;
        case 2:  // Refers to 0x8120 : Index 2
            memcpy(&ADCCalibrationSetting0x8120.CurrentOffset, pData, dataSize);
            //voltage_offset_channel[0] = ADCCalibrationSetting0x8120.Offset;
            channel[current_channel].adc_current_offset = ADCCalibrationSetting0x8120.CurrentOffset;
            break;
        case 3:  // Refers to 0x8120 : Index 3
            memcpy(&ADCCalibrationSetting0x8120.VoltageGradient, pData, dataSize);
            channel[current_channel].adc_voltage_gradient = ADCCalibrationSetting0x8120.VoltageGradient;
            //voltage_gradient_channel[channel] = ADCCalibrationSetting0x8120.Gradient;
            break;
        case 4:  // Refers to 0x8120 : Index 4
            memcpy(&ADCCalibrationSetting0x8120.VoltageOffset, pData, dataSize);
            //voltage_offset_channel[0] = ADCCalibrationSetting0x8120.Offset;
            channel[current_channel].adc_voltage_offset = ADCCalibrationSetting0x8120.VoltageOffset;
            break;
        case 5:  // Refers to 0x8120 : Index 5
            memcpy(&ADCCalibrationSetting0x8120.Channel, pData, dataSize);
            current_channel = ADCCalibrationSetting0x8120.Channel;
            break;
        default:
            return ABORTIDX_SUBINDEX_NOT_EXISTING;
            break;
    }
    return 0;

}


