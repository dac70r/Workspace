
#include "sys/alt_stdio.h"
#include "peripheral/peripheral_linker.h"
#include "imported_source/ViCAT_LSC.h"
#include "stdint.h"
int main()
{
	// led status will be used as ESC_SPI_NSS

	alt_u8 led_status = 0;
	alt_u32 value =0;
	uint8_t pio_data = 0;
	uint8_t bit_value = 0;

	// Event loop that runs forever
	while (1){
		IOWR_ALTERA_AVALON_PIO_DATA(0x41020, 0xFF);
		pio_data = IORD_ALTERA_AVALON_PIO_DATA(0x41020); // Read the full data from PIO
		bit_value = pio_data & 0x01;  // Mask to get the least significant bit (1-bit value)
		IOWR_ALTERA_AVALON_PIO_DATA(0x41020, 0x00);
		alt_putstr("Delay 1000ms !\n");
		led_status = ~led_status;
		alt_busy_sleep(500000);
		//main_initial();
	}

  return 0;
}
