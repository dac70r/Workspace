#ifndef PERIPHERAL_LINKER_H
#define PERIPHERAL_LINKER_H

// Base addresses for peripherals (example addresses, these will depend on your actual hardware)
#define PERIPHERAL_BASE_ADDR   0x40000000
#define TIMER_BASE_ADDR        0x40010000
#define UART_BASE_ADDR         0x40020000
#define GPIO_BASE_ADDR         0x40030000

// Define memory-mapped registers for each peripheral
// Example: Timer registers
#define TIMER_CTRL_REG         (*(volatile unsigned int *)(TIMER_BASE_ADDR + 0x00))
#define TIMER_STATUS_REG       (*(volatile unsigned int *)(TIMER_BASE_ADDR + 0x04))
#define TIMER_LOAD_REG         (*(volatile unsigned int *)(TIMER_BASE_ADDR + 0x08))

// Example: UART registers
#define UART_DATA_REG          (*(volatile unsigned int *)(UART_BASE_ADDR + 0x00))
#define UART_STATUS_REG        (*(volatile unsigned int *)(UART_BASE_ADDR + 0x04))
#define UART_CTRL_REG          (*(volatile unsigned int *)(UART_BASE_ADDR + 0x08))

// Example: GPIO registers
#define GPIO_DIR_REG           (*(volatile unsigned int *)(GPIO_BASE_ADDR + 0x00))
#define GPIO_DATA_REG          (*(volatile unsigned int *)(GPIO_BASE_ADDR + 0x04))
#define GPIO_CTRL_REG          (*(volatile unsigned int *)(GPIO_BASE_ADDR + 0x08))

// Macros for controlling peripherals (e.g., setting, clearing, or toggling bits)
#define TIMER_ENABLE()         (TIMER_CTRL_REG |= 0x1)    // Enable the timer
#define TIMER_DISABLE()        (TIMER_CTRL_REG &= ~0x1)   // Disable the timer
#define UART_ENABLE()          (UART_CTRL_REG |= 0x1)     // Enable UART
#define GPIO_SET_PIN(pin)      (GPIO_DATA_REG |= (1 << (pin))) // Set GPIO pin high
#define GPIO_CLEAR_PIN(pin)    (GPIO_DATA_REG &= ~(1 << (pin))) // Set GPIO pin low

#endif // LINKER_H
