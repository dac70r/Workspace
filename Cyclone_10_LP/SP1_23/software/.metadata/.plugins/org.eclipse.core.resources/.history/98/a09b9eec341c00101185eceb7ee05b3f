#include "alt_types.h"

#include "altera_avalon_spi_regs.h"
#include "altera_avalon_spi.h"

/* This is a very simple routine which performs one SPI master transaction.
 * It would be possible to implement a more efficient version using interrupts
 * and sleeping threads but this is probably not worthwhile initially.
 */

int alt_avalon_spi_command(alt_u32 base, alt_u32 slave,
                           alt_u32 write_length, const alt_u8 * spiTxBuf,
                           alt_u32 read_length, alt_u8 * spiRxBuf,
                           alt_u32 flags)
{
	alt_u32 length = write_length;
    const alt_u8 *tx_end = spiTxBuf + length;  // Pointer to the end of the transmit buffer
    alt_u32 status;
    alt_32 credits = 1;  // Number of credits (to manage TX/RX flow)

    // Select the SPI slave
    IOWR_ALTERA_AVALON_SPI_SLAVE_SEL(base, 1 << slave);

    // Activate chip select unless toggling is requested
    if ((flags & ALT_AVALON_SPI_COMMAND_TOGGLE_SS_N) == 0) {
        IOWR_ALTERA_AVALON_SPI_CONTROL(base, ALTERA_AVALON_SPI_CONTROL_SSO_MSK);
    }

    // Clear any stale RX data before starting the transfer
    IORD_ALTERA_AVALON_SPI_RXDATA(base);

    // Keep clocking until all data has been processed
    while (spiTxBuf < tx_end) {

        // Wait until either the TX or RX register is ready
        do {
            status = IORD_ALTERA_AVALON_SPI_STATUS(base);
        } while (((status & ALTERA_AVALON_SPI_STATUS_TRDY_MSK) == 0 || credits == 0) &&
                 (status & ALTERA_AVALON_SPI_STATUS_RRDY_MSK) == 0);

        // Transmit if TX is ready and there are credits left to send
        if ((status & ALTERA_AVALON_SPI_STATUS_TRDY_MSK) && credits > 0) {
            IOWR_ALTERA_AVALON_SPI_TXDATA(base, *spiTxBuf++);  // Send a byte from the TX buffer
            credits--;  // Decrease credits since data was sent
        }

        // Receive if RX is ready and there is space to store data
        if ((status & ALTERA_AVALON_SPI_STATUS_RRDY_MSK)) {
            *spiRxBuf++ = (alt_u8)IORD_ALTERA_AVALON_SPI_RXDATA(base);  // Store the received byte into RX buffer
            credits++;  // Increase credits after reading a byte
        }
    }

    // Wait until the interface has finished transmitting (all data sent)
    do {
        status = IORD_ALTERA_AVALON_SPI_STATUS(base);
    } while ((status & ALTERA_AVALON_SPI_STATUS_TMT_MSK) == 0);

    // Release chip select unless the caller is going to keep using this chip
    if ((flags & ALT_AVALON_SPI_COMMAND_MERGE) == 0) {
        IOWR_ALTERA_AVALON_SPI_CONTROL(base, 0);
    }

    return length;  // Return the number of bytes transferred
}
