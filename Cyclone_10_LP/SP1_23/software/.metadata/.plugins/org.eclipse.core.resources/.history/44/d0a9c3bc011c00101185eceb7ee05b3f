// timer ISR - Triggers every period of the timer0
void timer_isr_tim0(void *context) {
	static int led_state = 0;

	// Toggle LED state
	led_state = !led_state;
	IOWR_ALTERA_AVALON_PIO_DATA(GPIO_BASE, led_state);

    // Clear the timer interrupt
    IOWR_ALTERA_AVALON_TIMER_STATUS(TIMER_0_BASE, 0);

    // Prints the message on Console (UART to Console is established through a USB Blaster)
    // Such that the message appears in synchronous with the LED
    alt_putstr("Hello from Timer 0!\n");
}

// timer ISR - Triggers every period of the timer1
void timer_isr_tim1(void *context) {

    // Clear the timer interrupt
    IOWR_ALTERA_AVALON_TIMER_STATUS(TIMER_1_BASE, 0);

    // Prints the message on Console (UART to Console is established through a USB Blaster)
    // Such that the message appears in synchronous with the LED
    alt_putstr("Hello from Timer 1!\n");
}

// Initializes and Starts the Timer
void init_timer0 (void) {
	// Initializes and starts timer 0
	IOWR_ALTERA_AVALON_TIMER_CONTROL(TIMER_0_BASE,
									 ALTERA_AVALON_TIMER_CONTROL_START_MSK |	//starts the timer
									 ALTERA_AVALON_TIMER_CONTROL_CONT_MSK |		//timer will restart after reaching the period value
									 ALTERA_AVALON_TIMER_CONTROL_ITO_MSK);		//timer generates an interrupt when reaching timeout value

	// Register the ISR
	alt_ic_isr_register(TIMER_0_IRQ_INTERRUPT_CONTROLLER_ID,
						TIMER_0_IRQ,
						timer_isr_tim0,
						NULL,
						NULL);
}

// Initializes and Starts the Timer
void init_timer1 (void) {
	// Initializes and starts timer 1
	// Sets the timer period for timer 1
	IOWR_ALTERA_AVALON_TIMER_PERIODL(TIMER_1_BASE, 0xF080);
	IOWR_ALTERA_AVALON_TIMER_PERIODH(TIMER_1_BASE, 0x02FA);  // 50 million (50 MHz * 1 second)

	IOWR_ALTERA_AVALON_TIMER_CONTROL(TIMER_1_BASE,
									 ALTERA_AVALON_TIMER_CONTROL_START_MSK |	//starts the timer
